---
"@explicit": true
"@embed": "@never"
"@omitDefault": true

"@context":
  skos: "http://www.w3.org/2004/02/skos/core#"
  dct: "http://purl.org/dc/terms/"
  xsd: "http://www.w3.org/2001/XMLSchema#"
  clvapit: "https://w3id.org/italia/onto/CLV/"

  url:
    "@id": "@id"

  id:
    "@id": skos:notation
    "@type": "xsd:string"

  label_it:
    "@id": skos:prefLabel
    "@language": it

  label_en:
    "@id": skos:prefLabel
    "@language": en

  notation:
    "@id": skos:notation

  parent:
    "@id": skos:broader
    "@type": "@id"

  level:
    "@id": clvapit:hasRankOrder
    "@type": "xsd:integer"

  scheme:
    "@id": skos:inScheme
    "@type": "@id"

url: {}
id: {}
notation: {}
label_it:
  "@language": ["it"]
  "@value": {}
label_en:
  "@language": ["en"]
  "@value": {}
parent: {}
level: {}
scheme: {}