"@explicit": true
"@embed": "@never"
"@omitDefault": true
"@requireAll": true

"@context":
  skos: "http://www.w3.org/2004/02/skos/core#"
  dct: "http://purl.org/dc/terms/"
  xsd: "http://www.w3.org/2001/XMLSchema#"
  to: "https://w3id.org/italia/controlled-vocabulary/transparency-obligation-organization/"

  url:
    "@id": "@id"

  id:
