    "@language": it

  label_en:
    "@id": skos:prefLabel
    "@language": en

  notation:
    "@id": skos:notation

  parent:
    "@id": skos:broader
    "@type": "@id"
    "@container": "@set"

  scheme:
    "@id": skos:inScheme
    "@type": "@id"

  level:
    "@id": skos:broader
    "@type": "@id"

"@type": "skos:Concept"

scheme:
  - "https://w3id.org/italia/controlled-vocabulary/transparency-obligation-organization"

url: {}
id: {}
notation: {}
