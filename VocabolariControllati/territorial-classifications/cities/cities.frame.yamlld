{
  "@context": {
    "dct": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "clvapit": "https://w3id.org/italia/onto/CLV/",
    "l0": "https://w3id.org/italia/onto/l0/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },

  "@type": "skos:Concept",
  "@explicit": true,

  "skos:prefLabel": {},
  "skos:notation": {},
  "skos:broader": { "@embed": "@never" },
  "skos:broaderTransitive": { "@embed": "@never" },
  "skos:inScheme": { "@embed": "@never" },

  "clvapit:hasIdentifier": { "@embed": "@never" },
  "clvapit:hasHigherRank": { "@embed": "@never" },
  "clvapit:hasDirectHigherRank": { "@embed": "@never" },
  "clvapit:hasGeographicalDistribution": { "@embed": "@never" },
  "clvapit:hasSOValidity": { "@embed": "@never" },
  "clvapit:situatedWithin": { "@embed": "@never" },
  "clvapit:hasRankOrder": {},

  "owl:sameAs": { "@embed": "@never" },
  "l0:name": {},
  "rdfs:label": {}
}
