"@explicit": false
"@embed": "@never"
"@omitDefault": true
"@requireAll": false

"@context":
  skos: "http://www.w3.org/2004/02/skos/core#"
  clvapit: "https://w3id.org/italia/onto/CLV/"
  l0: "https://w3id.org/italia/onto/l0/"
  owl: "http://www.w3.org/2002/07/owl#"

  url: "@id"

  id: skos:notation

  label_it:
    "@id": skos:prefLabel
    "@language": it

  name_it:
    "@id": l0:name
    "@language": it

  broader:
    "@id": skos:broader
    "@type": "@id"

  scheme:
    "@id": skos:inScheme
    "@type": "@id"

  same_as:
    "@id": owl:sameAs
    "@type": "@id"

"@type": "clvapit:City"

scheme:
  - "https://w3id.org/italia/controlled-vocabulary/territorial-classifications/cities"

url: {}
id: {}
label_it:
  "@language": ["it"]
  "@value": {}
name_it:
  "@language": ["it"]
  "@value": {}
broader: {}
scheme: {}
same_as: {}
