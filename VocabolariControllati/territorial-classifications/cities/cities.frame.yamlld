{
  "@context": {
    "dct": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcatapit": "http://dati.gov.it/onto/dcatapit#",
    "adms": "http://www.w3.org/ns/adms#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "clvapit": "https://w3id.org/italia/onto/CLV/",
    "l0": "https://w3id.org/italia/onto/l0/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xkos": "http://rdf-vocabulary.ddialliance.org/xkos#",
    "ndc": "https://w3id.org/italia/onto/NDC/"
  },

  "@explicit": true,

  "@type": [
    "skos:ConceptScheme",
    "skos:Concept"
  ],

  "dct:title": {},
  "dct:description": {},
  "dct:identifier": {},
  "dct:issued": {},
  "dct:modified": {},
  "dct:language": { "@embed": "@never" },
  "dct:creator": { "@type": "dcatapit:Agent", "@embed": "@never" },
  "dct:publisher": { "@type": "dcatapit:Agent", "@embed": "@never" },
  "dct:rightsHolder": { "@type": "dcatapit:Agent", "@embed": "@never" },
  "dct:conformsTo": { "@embed": "@never" },
  "dct:type": { "@embed": "@never" },
  "dct:accrualPeriodicity": { "@embed": "@never" },

  "dcat:theme": { "@embed": "@never" },
  "dcat:keyword": {},
  "dcat:distribution": { "@embed": "@never" },
  "dcat:contactPoint": { "@embed": "@never" },

  "adms:representationTechnique": { "@embed": "@never" },

  "xkos:numberOfLevels": {},
  "ndc:keyConcept": {},

  "rdfs:label": {},
  "rdfs:comment": {},
  "rdfs:isDefinedBy": { "@embed": "@never" },

  "skos:prefLabel": {},
  "skos:altLabel": {},
  "skos:notation": {},
  "skos:definition": {},

  "skos:broader": {
    "@type": "skos:Concept",
    "@embed": "@never"
  },
  "skos:broaderTransitive": {
    "@type": "skos:Concept",
    "@embed": "@never"
  },
  "skos:narrower": {
    "@type": "skos:Concept",
    "@embed": "@never"
  },
  "skos:inScheme": {
    "@type": "skos:ConceptScheme",
    "@embed": "@never"
  },

  "clvapit:hasIdentifier": {
    "@embed": "@never"
  },
  "clvapit:hasHigherRank": {
    "@embed": "@never"
  },
  "clvapit:hasDirectHigherRank": {
    "@embed": "@never"
  },
  "clvapit:hasGeographicalDistribution": {
    "@embed": "@never"
  },
  "clvapit:hasSOValidity": {
    "@embed": "@never"
  },
  "clvapit:situatedWithin": {
    "@embed": "@never"
  },
  "clvapit:hasRankOrder": {},

  "owl:sameAs": { "@embed": "@never" },

  "l0:name": {}
}
